NODE_ENV=development

PORT=5000

# MongoDB connection string
DATABASE_URL=

BCRYPT_SALT_ROUND=12

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=10d
JWT_REFRESH_EXPIRES_IN=100d

# Public contact address shown/used by the settings module
ADMIN_EMAIL=

# Credentials for the superAdmin account seeded on first boot
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASS=

# Base URL of the public site, used to build sitemap.xml <loc> entries
SITE_URL=https://example.com

# Comma-separated list of allowed CORS origins for the deployed client site
CLIENT_URL=

# --- Transactional email (Plunk) -------------------------------------------
# Secret key from https://app.useplunk.com → Project settings → API keys.
# Without it the site still captures leads; it just cannot email anyone.
PLUNK_SECRET_KEY=
# Verified sender address in Plunk. Blank = Plunk account default.
MAIL_FROM=
MAIL_FROM_NAME=Interactive Software Care
# Inbox for new-lead alerts. Falls back to ADMIN_EMAIL when blank.
NOTIFY_EMAIL=
