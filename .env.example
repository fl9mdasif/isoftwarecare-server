NODE_ENV=development

PORT=5000

# MongoDB connection string
DATABASE_URL=

BCRYPT_SALT_ROUND=12

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=10d
JWT_REFRESH_EXPIRES_IN=100d

# Public contact address shown/used by the settings module
ADMIN_EMAIL=

# Credentials for the superAdmin account seeded on first boot
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASS=

# Base URL of the public site, used to build sitemap.xml <loc> entries
SITE_URL=https://example.com

# Comma-separated list of allowed CORS origins for the deployed client site
CLIENT_URL=

# --- Transactional email (Gmail SMTP) --------------------------------------
# GMAIL_APP_PASSWORD is a Google App Password (16 chars), NOT the account
# password. Create at myaccount.google.com -> Security -> App passwords.
# 2-Step Verification must be enabled on the account first.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Sender address. Blank = GMAIL_USER. Gmail only sends as a verified alias.
MAIL_FROM=
MAIL_FROM_NAME=Interactive Software Care
# Inbox for new-lead alerts. Falls back to ADMIN_EMAIL when blank.
NOTIFY_EMAIL=
